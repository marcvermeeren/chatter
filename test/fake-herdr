#!/bin/sh
# Fake herdr for behavioral tests: serves a canned roster ($FAKE_ROSTER file)
# and records every invocation ($FAKE_CALLS file).
echo "$*" >> "${FAKE_CALLS:?}"
case "$1 $2" in
  "agent list")         cat "${FAKE_ROSTER:?}" ;;
  "worktree create")    printf '{"result":{"worktree":{"path":"/fake/worktree"},"workspace":{"workspace_id":"w9"},"tab":{"tab_id":"w9:t1"},"root_pane":{"pane_id":"w9:p1"}}}\n' ;;
  "tab create")         printf '{"result":{"tab":{"tab_id":"w8:t1"},"root_pane":{"pane_id":"w8:p1"}}}\n' ;;
  "agent start")
    # Optional busy simulation: $FAKE_BUSY holds a countdown of busy refusals.
    if [ -n "${FAKE_BUSY:-}" ] && [ -s "$FAKE_BUSY" ]; then
      n=$(cat "$FAKE_BUSY")
      if [ "$n" -gt 0 ]; then
        echo $((n-1)) > "$FAKE_BUSY"
        printf '{"error":{"code":"agent_pane_busy","message":"not an available shell"}}\n'
        exit 1
      fi
    fi
    printf '{"result":{"agent":{"name":"%s","agent_status":"idle"}}}\n' "$3" ;;
  "pane get")           printf '{"result":{"pane":{"label":null}}}\n' ;;
  "agent prompt")       printf '{"result":{"type":"agent_prompted"}}\n' ;;
  "agent rename")       printf '{"result":{"type":"agent_renamed"}}\n' ;;
  "notification show")  printf '{"result":{"shown":true,"type":"notification_show"}}\n' ;;
  "plugin config-dir")  printf '%s\n' "${HERDR_PLUGIN_CONFIG_DIR:-/tmp}" ;;
  *)                    printf '{"result":{}}\n' ;;
esac
exit 0
